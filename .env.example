# Copy to .env and fill in from your Supabase project settings (Project Settings > API).
# EXPO_PUBLIC_ prefix required for Expo to inline these into the client bundle.
# The anon key is safe to expose client-side -- it is meaningless without
# Row Level Security, which every user-owned table in supabase/migrations/0001_init.sql enables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
